# ==========================================================
# docker compose 会自动读取本文件（复制为 .env 后按需修改）
# 本地开发不用 Docker 时，本文件不影响 mvn / npm 启动
# ==========================================================

# ---------- 数据库 ----------
# 容器内 root 密码；生产环境必须改掉
MYSQL_ROOT_PASSWORD=root123

# ---------- 安全 ----------
# JWT 签名密钥，长度必须 >= 32 字符。
# 生成方式：openssl rand -base64 48
JWT_SECRET=library-system-jwt-secret-key-2026-please-change-in-production-0123456789

# ---------- 跨域 ----------
# 允许访问后端的前端来源，逗号分隔，不要写 "*"
CORS_ORIGINS=http://localhost,http://127.0.0.1

# ==========================================================
# 以下为本地（非 Docker）启动时可选的环境变量，写进系统环境变量或用命令行前缀指定
# ==========================================================
# SERVER_PORT=8080              # 后端端口，默认 8080
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USERNAME=root
# MYSQL_PASSWORD=123456
# MYBATIS_LOG_IMPL=org.apache.ibatis.logging.nologging.NoLoggingImpl   # 生产关闭 SQL 日志
# VITE_PROXY_TARGET=http://localhost:8080                              # 前端 dev 代理目标
