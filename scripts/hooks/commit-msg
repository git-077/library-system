#!/bin/sh
# ============================================================
# commit-msg 钩子：校验提交信息是否符合 Conventional Commits
# ------------------------------------------------------------
# 安装（克隆仓库后执行一次即可，配置会写进 .git/config，不随仓库分发）：
#   git config core.hooksPath scripts/hooks
#
# 为什么不用 husky + commitlint：
#   husky 需要 root 级 node_modules（几十 MB），而这个项目后端是 Maven、前端在
#   frontend/ 子目录，根目录为了一个校验装一套 npm 依赖并不划算。
#   本脚本零依赖，Windows（Git Bash）/ macOS / Linux 都能直接跑。
#
# 规矩（与团队规范文档一致）：
#   <type>(<scope>)?: <subject>
#   type ∈ feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert
#   例：feat(borrow): 续借顺延 30 天
# ============================================================

msg_file="$1"
[ -z "$msg_file" ] && exit 0

first_line=$(head -n 1 "$msg_file" | sed 's/[[:space:]]*$//')

# 空提交信息直接拦下
if [ -z "$first_line" ]; then
  echo "✖ 提交信息不能为空"
  exit 1
fi

# 合并 / 回滚等 Git 自动生成的提交信息放行
case "$first_line" in
  "Merge "*|"Revert "*|"revert:"*|"fixup!"*|"squash!"*) exit 0 ;;
esac

pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-zA-Z0-9._/-]+\))?!?: .+$'

if echo "$first_line" | grep -Eq "$pattern"; then
  exit 0
fi

cat <<'EOF'
✖ 提交信息不符合规范，提交被拒绝。

正确格式：<type>(<scope>): <subject>
例如：
  feat(borrow): 借书失败时返回明确原因
  fix(book): 修复 ISBN 超长导致 500
  docs: 补充部署说明

可用 type：
  feat 新功能      fix 修复缺陷      docs 文档          style 代码格式
  refactor 重构    perf 性能优化     test 测试          build 构建/依赖
  ci CI 配置       chore 杂项        revert 回滚

补充说明：
  1. type 与冒号之间不要空格，冒号后必须有一个空格；
  2. subject 用一句话说清「做了什么」，不要写「修改」「update」这类无信息量的词；
  3. 想写详细正文，在第二行留空后另起。
EOF
exit 1
