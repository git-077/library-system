# 统一编辑器行为，避免「换个 IDE 就一片 diff」
# 详见 https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Java：4 空格缩进
[*.{java,xml}]
indent_size = 4

# Markdown 保留行尾空格（换行语义）
[*.md]
trim_trailing_whitespace = false

# YAML / SQL 用 2 空格
[*.{yml,yaml,sql,json,js,vue,css,html}]
indent_size = 2

# Windows 批处理必须是 CRLF，否则 cmd 解析异常
[*.bat]
end_of_line = crlf

[*.{sh}]
end_of_line = lf
