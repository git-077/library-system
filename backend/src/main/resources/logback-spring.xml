<?xml version="1.0" encoding="UTF-8"?>
<!--
  日志配置：一套代码，两种形态。

  - 本地/测试（非 prod）：彩色文本，人眼友好，MDC 的 traceId 放在方括号里，方便边跑边看。
  - 生产（SPRING_PROFILES_ACTIVE=prod）：单行 JSON，机器友好。
      * stdout 一份：容器化部署（docker logs / k8s）由采集器直接抓走；
      * 文件一份：按天+100MB 滚动、gzip 压缩、保留 15 天、总量封顶 2GB，防止日志把磁盘写满。
      * JSON 里 traceId / userId / username / httpMethod / uri / clientIp / httpStatus / costMs
        都是独立字段，可直接在 Kibana / Grafana 里 `traceId: "xxx"` 聚合出一次请求的全部日志。

  用法：mvn spring-boot:run -Dspring-boot.run.profiles=prod
       docker run -e SPRING_PROFILES_ACTIVE=prod -v /data/logs:/app/logs ...
-->
<configuration>

    <!-- 配置文件里的自定义路径与级别，避免 XML 里硬编码 -->
    <springProperty scope="context" name="LOG_DIR" source="logging.log-dir" defaultValue="./logs"/>
    <springProperty scope="context" name="APP_NAME" source="spring.application.name" defaultValue="library-backend"/>
    <springProperty scope="context" name="APP_LEVEL" source="logging.level.com.library" defaultValue="INFO"/>
    <springProperty scope="context" name="ROOT_LEVEL" source="logging.level.root" defaultValue="INFO"/>

    <!-- ============ 开发 / 测试：彩色文本 ============ -->
    <springProfile name="!prod">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <charset>UTF-8</charset>
                <!-- traceId 缺失时显示 no-trace：一眼看出这条日志不是从 HTTP 请求进来的 -->
                <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %highlight(%-5level) %magenta([%X{traceId:-no-trace}]) %cyan(%logger{36}) - %msg%n</pattern>
            </encoder>
        </appender>

        <root level="${ROOT_LEVEL}">
            <appender-ref ref="CONSOLE"/>
        </root>
        <logger name="com.library" level="${APP_LEVEL}"/>
    </springProfile>

    <!-- ============ 生产：单行 JSON ============ -->
    <springProfile name="prod">

        <!-- 公共 JSON 编码：includeMdc 把 traceId/userId 等摊平成顶层字段 -->
        <appender name="JSON_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <customFields>{"app":"${APP_NAME}","env":"prod"}</customFields>
                <includeMdc>true</includeMdc>
                <!-- 不输出 LoggerContext 里的全部属性：springProperty 会把 LOG_DIR 这类本机路径也带出来 -->
                <includeContext>false</includeContext>
                <shortenedLoggerNameLength>40</shortenedLoggerNameLength>
                <!-- 堆栈默认会把整段 SQL / 参数打出来，截断既保留根因又不炸日志量 -->
                <throwableConverter class="net.logstash.logback.stacktrace.ShortenedThrowableConverter">
                    <maxDepthPerThrowable>30</maxDepthPerThrowable>
                    <maxLength>4096</maxLength>
                    <rootCauseFirst>true</rootCauseFirst>
                </throwableConverter>
            </encoder>
        </appender>

        <appender name="JSON_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>${LOG_DIR}/${APP_NAME}.log</file>
            <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                <fileNamePattern>${LOG_DIR}/archive/${APP_NAME}.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
                <maxFileSize>100MB</maxFileSize>
                <maxHistory>15</maxHistory>
                <!-- 总量硬上限：异常风暴时宁可丢旧日志，也不能把宿主机磁盘写满 -->
                <totalSizeCap>2GB</totalSizeCap>
                <cleanHistoryOnStart>true</cleanHistoryOnStart>
            </rollingPolicy>
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <customFields>{"app":"${APP_NAME}","env":"prod"}</customFields>
                <includeMdc>true</includeMdc>
                <!-- 不输出 LoggerContext 里的全部属性：springProperty 会把 LOG_DIR 这类本机路径也带出来 -->
                <includeContext>false</includeContext>
                <shortenedLoggerNameLength>40</shortenedLoggerNameLength>
                <throwableConverter class="net.logstash.logback.stacktrace.ShortenedThrowableConverter">
                    <maxDepthPerThrowable>30</maxDepthPerThrowable>
                    <maxLength>4096</maxLength>
                    <rootCauseFirst>true</rootCauseFirst>
                </throwableConverter>
            </encoder>
        </appender>

        <root level="${ROOT_LEVEL}">
            <appender-ref ref="JSON_CONSOLE"/>
            <appender-ref ref="JSON_FILE"/>
        </root>
        <logger name="com.library" level="${APP_LEVEL}"/>

        <!-- 框架噪音降级：这些日志量大且排障价值低，需要时用 LOG_LEVEL 单独放开 -->
        <logger name="org.apache.ibatis" level="WARN"/>
        <logger name="com.zaxxer.hikari" level="WARN"/>
    </springProfile>

</configuration>
